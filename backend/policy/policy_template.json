{
  "_comment": "Hand-written defaults for a fictional lender. R2 thresholds are null here and are filled in by scripts/seed_policy_from_cutoff.py, which writes seed_policy.json. Edit thresholds in the admin UI, not here.",
  "rules": [
    {"rule_id": "R1", "kind": "ELIGIBILITY", "name": "Age", "enabled": true,
     "parameters": {"min_age_now": 21, "max_age_at_maturity": 60},
     "outcome_on_fail": "DECLINE", "reason_codes": ["ELIG_AGE"]},
    {"rule_id": "R2", "kind": "ELIGIBILITY", "name": "Credit score", "enabled": true,
     "parameters": {"approve_threshold": null, "refer_floor": null, "ntc_outcome": "REFER"},
     "outcome_on_fail": "DECLINE", "reason_codes": ["ELIG_SCORE_LOW", "ELIG_SCORE_BORDERLINE", "ELIG_THIN_FILE"]},
    {"rule_id": "R3", "kind": "ELIGIBILITY", "name": "Minimum income", "enabled": true,
     "parameters": {"min_monthly_income": 25000},
     "outcome_on_fail": "DECLINE", "reason_codes": ["ELIG_INCOME_LOW"]},
    {"rule_id": "R4", "kind": "ELIGIBILITY", "name": "FOIR (fixed obligations to income)", "enabled": true,
     "parameters": {"pass_max": 0.5, "refer_max": 0.6},
     "outcome_on_fail": "DECLINE", "reason_codes": ["ELIG_FOIR_HIGH"]},
    {"rule_id": "R5", "kind": "ELIGIBILITY", "name": "Employment stability", "enabled": true,
     "parameters": {"min_months_salaried": 6, "min_months_self_employed": 24},
     "outcome_on_fail": "REFER", "reason_codes": ["ELIG_EMPLOYMENT_TENURE"]},
    {"rule_id": "R6", "kind": "ELIGIBILITY", "name": "Loan-to-income cap", "enabled": true,
     "parameters": {"max_multiple_of_monthly_income": 20, "round_down_to": 1000},
     "outcome_on_fail": null, "reason_codes": ["INFO_AMOUNT_CAPPED", "ELIG_INCOME_LOW"]},
    {"rule_id": "F1", "kind": "FRAUD", "name": "Duplicate PAN", "enabled": true,
     "parameters": {},
     "outcome_on_fail": null, "reason_codes": ["FRAUD_DUPLICATE_PAN"]},
    {"rule_id": "F2", "kind": "FRAUD", "name": "Application velocity", "enabled": true,
     "parameters": {"window_hours": 24, "max_applications": 3},
     "outcome_on_fail": "REFER", "reason_codes": ["FRAUD_VELOCITY"]},
    {"rule_id": "F3", "kind": "FRAUD", "name": "Identity mismatch", "enabled": true,
     "parameters": {"name_similarity_min": 0.85},
     "outcome_on_fail": "REFER", "reason_codes": ["FRAUD_IDENTITY_MISMATCH"]},
    {"rule_id": "F4", "kind": "FRAUD", "name": "Income inconsistency", "enabled": true,
     "parameters": {"income_diff_max": 0.3},
     "outcome_on_fail": "REFER", "reason_codes": ["FRAUD_INCOME_MISMATCH"]},
    {"rule_id": "PRICING", "kind": "PRICING", "name": "Pricing and product limits", "enabled": true,
     "parameters": {
       "rate_bands": [
         {"min_score": 800, "annual_rate": 10.99},
         {"min_score": 750, "annual_rate": 12.99},
         {"min_score": 700, "annual_rate": 14.99},
         {"min_score": 650, "annual_rate": 17.99}
       ],
       "fallback_rate": 21.99,
       "processing_fee_rate": 0.02,
       "loan_amount_min": 50000,
       "loan_amount_max": 2500000,
       "tenure_months_min": 12,
       "tenure_months_max": 60,
       "offer_validity_days": 7,
       "cooling_off_days": 3,
       "grievance_contact": "grievance@lendwise.example"
     },
     "outcome_on_fail": null, "reason_codes": []}
  ]
}
