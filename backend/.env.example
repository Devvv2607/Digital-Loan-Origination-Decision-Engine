# Copy to backend/.env and fill in. Never commit the real .env.
ENV=development

# Database (docker compose exposes Postgres on 55432)
DATABASE_URL=postgresql+psycopg://lendwise:lendwise_local_only@localhost:55432/lendwise
TEST_DATABASE_URL=postgresql+psycopg://lendwise:lendwise_local_only@localhost:55432/lendwise_test

# Secrets: use long random strings (e.g. python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
JWT_TTL_MINUTES=60
PII_HASH_KEY=change-me-to-another-random-string

# Internal users (credentials only ever come from the environment)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin
OPS_USERNAME=ops
OPS_PASSWORD=change-me-ops

# Demo behaviour
DEMO_MODE=true          # show simulated OTPs on screen
DEMO_READ_ONLY=true     # public read-only access to internal screens
MOCK_LATENCY_MS=300
PROVIDER_RETRY_BACKOFF_MS=500

# default | simulation | off  (simulation raises per-IP technical limits only)
RATE_LIMIT_PROFILE=default

CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
